{
  "manifest_version": 3,
  "name": "GitHub Cloud Downloader",
  "version": "3.0",
  "description": "تحميل الفيديوهات عبر GitHub Actions وإرسالها لتليجرام",
  "permissions": ["activeTab"],
  "host_permissions": ["https://api.github.com/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
