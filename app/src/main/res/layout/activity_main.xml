<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="AWR Studio Ultra" android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:id="@+id/mediaCounter" android:layout_width="wrap_content" android:layout_height="42dp"
            android:gravity="center" android:paddingLeft="18dp" android:paddingRight="18dp"
            android:background="@drawable/soft_panel" android:text="0 found" android:textColor="@color/text" android:textStyle="bold"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <ScrollView android:id="@+id/homePage" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="210dp"
                    android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Ultra Media Extractor" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:text="Grouped qualities, thumbnail/title detection, duplicate filter, video/audio modes, progress tracking."
                        android:textColor="@color/muted" android:textSize="15sp"/>
                    <Button android:id="@+id/startBrowserBtn" android:layout_width="match_parent" android:layout_height="54dp"
                        android:layout_marginTop="24dp" android:background="@drawable/gradient_button"
                        android:text="Open WebView" android:textColor="@color/text" android:textStyle="bold"/>
                </LinearLayout>

                <Button android:id="@+id/homeToDetectedBtn" android:layout_width="match_parent" android:layout_height="58dp"
                    android:layout_marginTop="18dp" android:background="@drawable/soft_panel" android:text="Detected Media" android:textColor="@color/text"/>
                <Button android:id="@+id/homeToDownloadsBtn" android:layout_width="match_parent" android:layout_height="58dp"
                    android:layout_marginTop="12dp" android:background="@drawable/soft_panel" android:text="Downloads Progress" android:textColor="@color/text"/>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/browserPage" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:padding="8dp">
                <EditText android:id="@+id/urlBox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:singleLine="true" android:textColor="@color/text" android:textColorHint="@color/muted" android:hint="https://"
                    android:background="@drawable/input_bg" android:padding="12dp"/>
                <Button android:id="@+id/goBtn" android:layout_width="76dp" android:layout_height="match_parent" android:layout_marginLeft="8dp"
                    android:background="@drawable/gradient_button" android:text="Go" android:textColor="@color/text"/>
            </LinearLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <Button android:id="@+id/downloadFloat" android:layout_width="wrap_content" android:layout_height="56dp"
                    android:layout_gravity="bottom|end" android:layout_margin="18dp" android:background="@drawable/gradient_button"
                    android:text="⬇ 0" android:textColor="@color/text" android:textStyle="bold"/>
            </FrameLayout>
        </LinearLayout>

        <ScrollView android:id="@+id/detectedPage" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Detected Media" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold"/>
                <TextView android:id="@+id/mediaHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:background="@drawable/panel_bg" android:padding="16dp"
                    android:text="No metadata yet." android:textColor="@color/muted" android:textSize="14sp"/>
                <LinearLayout android:id="@+id/detectedList" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/downloadsPage" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Downloads" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Files go to: Downloads/AWR Studio/" android:textColor="@color/muted" android:textSize="13sp"/>
            <LinearLayout android:id="@+id/downloadsList" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="14dp" android:orientation="vertical"
                android:background="@drawable/panel_bg" android:padding="12dp"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:orientation="horizontal" android:padding="8dp">
        <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="HOME"/>
        <Button android:id="@+id/navBrowser" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="WEB"/>
        <Button android:id="@+id/navDetected" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="MEDIA"/>
        <Button android:id="@+id/navDownloads" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="FILES"/>
    </LinearLayout>
</LinearLayout>
