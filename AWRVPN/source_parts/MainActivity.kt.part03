            setGravity(Gravity.BOTTOM)
        }
        d.setOnShowListener {
            d.window?.setLayout(WindowManager.LayoutParams.MATCH_PARENT, (resources.displayMetrics.heightPixels * .82f).toInt())
        }
        d.show()
    }

    private fun showSettingsDialog() {
        val pair = styledDialog("AWR CONTROL CENTER", "Security, DNS and device access")
        val d = pair.first
        val box = pair.second
        box.addView(optionRow("SECURE DNS", dns.label, false) {
            d.dismiss(); showDnsDialog()
        })
        box.addView(optionRow("ANDROID KILL SWITCH", "Always-on VPN + block without VPN", false) {
            startActivity(Intent(Settings.ACTION_VPN_SETTINGS))
        })
        box.addView(optionRow("REFRESH SERVER VAULT", "Request a fresh VIP-authorized catalog", false) {
            d.dismiss(); if (vip.isVip()) loadCatalog(false) else showVipDialog()
        })
        box.addView(optionRow("AWR VIP", if (vip.isVip()) "Active on this device" else "Required for VPN access", vip.isVip()) {
            d.dismiss(); showVipDialog()
        })
        d.show()
    }

    private fun showDnsDialog() {
        val pair = styledDialog("SECURE DNS", "DNS is injected into the protected OpenVPN profile")
        val d = pair.first
        val box = pair.second
        DnsMode.values().forEach { mode ->
            box.addView(optionRow(mode.label, "${mode.d1}  •  ${mode.d2}", mode == dns) {
                dns = mode
                d.dismiss()
                syncUi()
            })
        }
        d.show()
    }

    private fun styledDialog(title: String, subtitle: String): Pair<Dialog, LinearLayout> {
        val d = Dialog(this)
        d.requestWindowFeature(Window.FEATURE_NO_TITLE)
        val shell = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(22), dp(22), dp(22), dp(22))
            background = rounded(Color.rgb(9, 18, 30), 27f, Color.rgb(43, 70, 87), 1)
        }
        shell.addView(TextView(this).apply {
            text = title
            textSize = 22f
            setTextColor(Color.WHITE)
            typeface = Typeface.create("sans-serif-medium", Typeface.BOLD)
        })
        shell.addView(TextView(this).apply {
            text = subtitle
            textSize = 13f
            setTextColor(Color.rgb(142, 164, 181))
            setPadding(0, dp(6), 0, dp(13))
        })
        d.setContentView(shell)
        d.window?.apply {
            setBackgroundDrawableResource(android.R.color.transparent)
            addFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND)
            attributes = attributes.apply { dimAmount = .78f }
        }
        d.setOnShowListener {
            d.window?.setLayout((resources.displayMetrics.widthPixels * .92f).toInt(), WindowManager.LayoutParams.WRAP_CONTENT)
        }
        return d to shell
    }

    private fun optionRow(title: String, sub: String, selected: Boolean, click: () -> Unit): View {
        return LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(16), dp(14), dp(16), dp(14))
            background = rounded(
                if (selected) Color.argb(32, 71, 243, 198) else Color.rgb(12, 25, 40),
                17f,
                if (selected) Color.argb(100, 71, 243, 198) else Color.rgb(35, 56, 72),
                1
            )
            addView(TextView(this@MainActivity).apply {
                text = if (selected) "✓  $title" else title
                textSize = 15f
                setTextColor(if (selected) Color.rgb(71, 243, 198) else Color.WHITE)
                typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
            })
            addView(TextView(this@MainActivity).apply {
                text = sub
                textSize = 12f
                setTextColor(Color.rgb(130, 151, 168))
                setPadding(0, dp(4), 0, 0)
            })
            setOnClickListener { click() }
            layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(9) }
        }
    }

    private fun serverRow(server: ServerInfo, isSelected: Boolean, click: () -> Unit): View {
        return LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
            setPadding(dp(13), dp(12), dp(13), dp(12))
            background = rounded(
                if (isSelected) Color.argb(35, 71, 243, 198) else Color.rgb(11, 24, 39),
                17f,
                if (isSelected) Color.argb(105, 71, 243, 198) else Color.rgb(31, 53, 69),
                1
            )
            addView(TextView(this@MainActivity).apply {
                text = server.flag
                textSize = 27f
                gravity = Gravity.CENTER
            }, LinearLayout.LayoutParams(dp(44), dp(44)))
            addView(LinearLayout(this@MainActivity).apply {
                orientation = LinearLayout.VERTICAL
