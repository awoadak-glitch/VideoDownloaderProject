        p.color = Color.argb(190, 4, 20, 26)
        c.drawText(if (state.phase == ConnPhase.ON) "DISCONNECT" else "CONNECT", cx, cy + d(39f), p)

        p.typeface = regular
        p.textSize = d(11.5f)
        p.color = if (state.phase == ConnPhase.ERROR) Color.rgb(255, 137, 143) else Color.rgb(133, 156, 173)
        val sub = when {
            state.phase == ConnPhase.ERROR && state.error.isNotBlank() -> state.error.take(42)
            state.phase == ConnPhase.ON -> "Traffic is protected by the encrypted tunnel"
            !state.vip -> "Activate AWR-VIP to unlock the server repository"
            else -> "Tap the core to establish a protected route"
        }
        c.drawText(sub, cx, cy + d(145f), p)
        p.textAlign = Paint.Align.LEFT
    }

    private fun drawMetricRail(c: Canvas, w: Float, h: Float) {
        val top = h * .60f
        val margin = d(22f)
        val gap = d(8f)
        val cardW = (w - margin * 2 - gap * 2) / 3f
        val cardH = d(60f)

        fun metric(x: Float, label: String, value: String, accent: Int, hit: RectF? = null) {
            val r = RectF(x, top, x + cardW, top + cardH)
            p.color = Color.argb(165, 10, 24, 38)
            c.drawRoundRect(r, d(16f), d(16f), p)
            stroke.strokeWidth = d(.8f)
            stroke.color = Color.argb(85, 47, 73, 90)
            c.drawRoundRect(r, d(16f), d(16f), stroke)
            p.typeface = regular
            p.textSize = d(8f)
            p.color = Color.rgb(101, 128, 147)
                c.drawText(label, x + d(11f), top + d(19f), p)
                p.typeface = bold
            p.textSize = d(12f)
            p.color = accent
            c.drawText(value, x + d(11f), top + d(42f), p)
            hit?.set(r)
        }

        metric(margin, "PROTOCOL", state.protocol, Color.WHITE, protocolHit)
        metric(margin + cardW + gap, "SECURE DNS", state.dns, Color.rgb(144, 211, 230))
        metric(margin + (cardW + gap) * 2, "REPOSITORY", if (state.vip) "UNLOCKED" else "LOCKED", if (state.vip) Color.rgb(71, 243, 198) else Color.rgb(255, 196, 91))
    }

    private fun drawServerCard(c: Canvas, w: Float, h: Float) {
        val margin = d(22f)
        val top = h * .69f
        val bottom = min(h - d(105f), top + d(104f))
        serverHit.set(margin, top, w - margin, bottom)
        p.color = Color.argb(188, 9, 22, 36)
        c.drawRoundRect(serverHit, d(22f), d(22f), p)
        stroke.strokeWidth = d(1f)
        stroke.color = if (state.vip) Color.argb(70, 71, 243, 198) else Color.argb(70, 255, 196, 91)
        c.drawRoundRect(serverHit, d(22f), d(22f), stroke)

        p.textSize = d(28f)
        p.typeface = regular
        c.drawText(state.flag, margin + d(16f), top + d(46f), p)
        p.typeface = medium
        p.textSize = d(15f)
        p.color = Color.WHITE
        c.drawText(state.server.take(28), margin + d(58f), top + d(34f), p)
        p.typeface = regular
        p.textSize = d(10.5f)
        p.color = Color.rgb(117, 142, 160)
        val detail = if (!state.vip) "AWR-VIP authorization required" else {
            val ping = if (state.ping > 0) "${state.ping} ms published" else "Route selected"
            "$ping  •  ${state.serverCount} available endpoints"
        }
        c.drawText(detail, margin + d(58f), top + d(55f), p)

        val label = if (loadingRepository) "SYNCING…" else if (state.vip) "CHANGE" else "UNLOCK"
        p.typeface = bold
        p.textSize = d(9f)
        p.color = if (state.vip) Color.rgb(71, 243, 198) else Color.rgb(255, 201, 103)
        p.textAlign = Paint.Align.RIGHT
        c.drawText(label, w - margin - d(16f), top + d(47f), p)
        p.textAlign = Paint.Align.LEFT
    }

    private fun drawBottomNav(c: Canvas, w: Float, h: Float) {
        val barTop = h - d(78f)
        val margin = d(18f)
        val bar = RectF(margin, barTop, w - margin, h - d(16f))
        p.color = Color.argb(220, 7, 18, 30)
        c.drawRoundRect(bar, d(23f), d(23f), p)
        stroke.strokeWidth = d(.8f)
        stroke.color = Color.argb(80, 43, 67, 84)
        c.drawRoundRect(bar, d(23f), d(23f), stroke)

        val cell = bar.width() / 4f
        val labels = arrayOf("HOME", "SERVERS", "VIP", "SETTINGS")
        val icons = arrayOf("⌂", "◉", "✦", "⚙")
        for (i in 0..3) {
            val cx = bar.left + cell * (i + .5f)
            p.textAlign = Paint.Align.CENTER
            p.typeface = medium
            p.textSize = d(16f)
            p.color = when (i) {
                0 -> Color.rgb(71, 243, 198)
                2 -> if (state.vip) Color.rgb(71, 243, 198) else Color.rgb(255, 201, 103)
                else -> Color.rgb(126, 149, 166)
            }
            c.drawText(icons[i], cx, barTop + d(25f), p)
            p.typeface = bold
            p.textSize = d(7.5f)
            p.color = if (i == 0) Color.rgb(71, 243, 198) else Color.rgb(104, 128, 146)
            c.drawText(labels[i], cx, barTop + d(47f), p)
        }
        p.textAlign = Paint.Align.LEFT
