        p.color = if (state.vip) Color.rgb(71, 243, 198) else Color.rgb(255, 207, 112)
        p.textAlign = Paint.Align.CENTER
        c.drawText(if (state.vip) "✦  VIP ACTIVE" else "⌁  AWR VIP", vipHit.centerX(), vipHit.centerY() + d(3.5f), p)
        p.textAlign = Paint.Align.LEFT
    }

    private fun drawHero(c: Canvas, w: Float, h: Float) {
        val cx = w / 2f
        val cy = h * .38f
        val t = phaseAnim * (Math.PI * 2).toFloat()

        p.typeface = medium
        p.textAlign = Paint.Align.CENTER
        p.textSize = d(10f)
        p.color = when (state.phase) {
            ConnPhase.ON -> Color.rgb(71, 243, 198)
            ConnPhase.ERROR -> Color.rgb(255, 112, 120)
            ConnPhase.OFF -> Color.rgb(117, 142, 160)
            else -> Color.rgb(132, 202, 224)
        }
        val statusLabel = when (state.phase) {
            ConnPhase.ON -> "SECURE TUNNEL ACTIVE"
            ConnPhase.FINDING -> "FINDING BEST ROUTE"
            ConnPhase.AUTH -> "AUTHORIZING DEVICE"
            ConnPhase.CONNECTING -> "ESTABLISHING TUNNEL"
            ConnPhase.ERROR -> "CONNECTION INTERRUPTED"
            ConnPhase.OFF -> if (state.vip) "READY FOR PRIVATE ROUTE" else "VIP REQUIRED TO CONNECT"
        }
        c.drawText(statusLabel, cx, cy - d(150f), p)

        // outer orbital rings
        for (i in 0..2) {
            val r = d(124f + i * 13f) + if (state.phase != ConnPhase.OFF) d(3f * sin(t + i)) else 0f
            stroke.strokeWidth = d(if (i == 0) 1.3f else .7f)
            stroke.color = if (state.phase == ConnPhase.ON) Color.argb(80 - i * 18, 71, 243, 198) else Color.argb(45 - i * 10, 102, 175, 202)
            c.drawCircle(cx, cy, r, stroke)
        }

        // moving orbit dots
        if (state.phase != ConnPhase.OFF) {
            listOf(.0f, 2.1f, 4.2f).forEachIndexed { i, offset ->
                val a = t * (if (i % 2 == 0) 1f else -1f) + offset
                val r = d(137f + i * 5f)
                val x = cx + cos(a) * r
                val y = cy + sin(a) * r
                p.color = if (state.phase == ConnPhase.ON) Color.rgb(71, 243, 198) else Color.rgb(102, 205, 235)
                c.drawCircle(x, y, d(2.3f), p)
            }
        }

        // globe
        val globeR = d(106f)
        p.shader = RadialGradient(cx - d(28f), cy - d(35f), globeR * 1.35f,
            intArrayOf(Color.rgb(18, 54, 70), Color.rgb(8, 31, 47), Color.rgb(5, 15, 26)), null, Shader.TileMode.CLAMP)
        c.drawCircle(cx, cy, globeR, p)
        p.shader = null
        stroke.strokeWidth = d(1f)
        stroke.color = Color.argb(55, 117, 208, 219)
        c.drawCircle(cx, cy, globeR, stroke)

        val save = c.save()
        c.clipPath(Path().apply { addCircle(cx, cy, globeR - d(1f), Path.Direction.CW) })
        stroke.color = Color.argb(38, 105, 201, 211)
        stroke.strokeWidth = d(.8f)
        for (i in -2..2) {
            val yy = cy + i * d(28f)
            c.drawOval(RectF(cx - globeR, yy - d(14f), cx + globeR, yy + d(14f)), stroke)
        }
        for (i in -2..2) {
            val ww = globeR * (0.28f + abs(i) * .22f)
            c.drawOval(RectF(cx - ww, cy - globeR, cx + ww, cy + globeR), stroke)
        }
        // route streaks
        stroke.strokeWidth = d(2.2f)
        stroke.color = Color.argb(if (state.phase == ConnPhase.ON) 150 else 80, 71, 243, 198)
        val route = Path().apply {
            moveTo(cx - d(83f), cy + d(27f))
            cubicTo(cx - d(45f), cy - d(68f), cx + d(55f), cy - d(61f), cx + d(84f), cy + d(13f))
        }
        c.drawPath(route, stroke)
        c.restoreToCount(save)

        // pulse / connect core
        val coreR = d(62f)
        val pulse = if (state.phase == ConnPhase.ON || state.phase == ConnPhase.CONNECTING || state.phase == ConnPhase.FINDING || state.phase == ConnPhase.AUTH) (sin(t) + 1f) / 2f else .1f
        p.color = when (state.phase) {
            ConnPhase.ON -> Color.argb((35 + 30 * pulse).toInt(), 71, 243, 198)
            ConnPhase.ERROR -> Color.argb(45, 255, 105, 113)
            else -> Color.argb((22 + 18 * pulse).toInt(), 83, 183, 216)
        }
        c.drawCircle(cx, cy, coreR + d(15f * pulse), p)

        val coreColor = when (state.phase) {
            ConnPhase.ON -> Color.rgb(71, 243, 198)
            ConnPhase.ERROR -> Color.rgb(255, 111, 120)
            ConnPhase.OFF -> if (state.vip) Color.rgb(228, 246, 249) else Color.rgb(135, 153, 169)
            else -> Color.rgb(104, 214, 237)
        }
        p.shader = RadialGradient(cx - d(18f), cy - d(20f), coreR * 1.45f,
            lighten(coreColor, .18f), darken(coreColor, .28f), Shader.TileMode.CLAMP)
        c.drawCircle(cx, cy, coreR, p)
        p.shader = null

        connectHit.set(cx - coreR, cy - coreR, cx + coreR, cy + coreR)
        drawPowerIcon(c, cx, cy - d(4f), if (state.phase == ConnPhase.OFF) Color.rgb(7, 22, 31) else Color.rgb(4, 20, 26))
        p.typeface = bold
        p.textSize = d(9f)
        p.textAlign = Paint.Align.CENTER
